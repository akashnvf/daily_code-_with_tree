day 02 - Service & Tags

🔹 Ansible — Install & Enable Nginx
- name: Install and start Nginx on Pathnex
  hosts: all
  become: yes
 
  tasks:
    - name: Install: nginx
      yum:
	    name: nginx
	    state: present
	   
	   
	- name: Enable nginx
	  service:
	    name: nginx
		state: started
		enable: yes

🔹  Terraform - EC2 with Tags (r5.2xlargeL)
provide "aws" {
  region = "us-east-1"
}

resource "aws_instance" "PathnexEC2" {
  ami           = "ami-0abcd1234abcd1234"
  instance_type = "r5.2xlarge"

  tags= {
    name        = "pathenx-server"
    Environment = "Training"
    owner       = "PathnexStudents"
  }  
}


